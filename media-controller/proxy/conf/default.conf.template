server {
    listen 4443 ssl;
    http2 on;
    server_name archpinball.dev;
    ssl_certificate /certs/server.crt;
    ssl_certificate_key /certs/server.key;
    include /etc/nginx/includes/ssl.conf;

    # Resolve upstreams at request time, not at startup
    resolver ${NAMESERVER} valid=2s;
    resolver_timeout 1s;
    set $mc_front_upstream mc-front:4200;
    set $mc_back_upstream mc-back:5000;
    set $dev_tools_upstream localhost:9223;

    error_page 502 503 504 =503 /waiting.html;

    location = /waiting.html {
        root /usr/share/nginx/html;
        internal;
    }

    location /ws {
        include /etc/nginx/includes/proxy.conf;
        include /etc/nginx/includes/wss.conf;
        proxy_pass http://$mc_back_upstream;
        proxy_read_timeout 36000s;
    }

    location / {
        include /etc/nginx/includes/proxy.conf;
        proxy_pass http://$mc_front_upstream;
    }

    location /rdt {
        include /etc/nginx/includes/proxy.conf;
        proxy_pass http://$dev_tools_upstream;
    }

    access_log on;
    error_log /var/log/nginx/error.log error;
}

server {
    listen 9223;
    http2 on;
    server_name archpinball.dev;

    resolver ${NAMESERVER} valid=5s;
    set $dev_tools_upstream localhost:9223;

    location / {
        include /etc/nginx/includes/proxy.conf;
        proxy_pass http://$dev_tools_upstream;
    }
}