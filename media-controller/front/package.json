{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "container-serve": "ng serve --host 0.0.0.0 --live-reload=false",
    "check:peers": "node scripts/check-peers.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --no-watch --coverage",
    "lint": "eslint ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@angular/router": "22.1.1",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "@webgpu/types": "^0.1.70",
    "h5dmd": "^2.3.0",
    "ngx-json-treeview": "^22.0.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.1",
    "@angular/cli": "22.1.1",
    "@angular/compiler-cli": "22.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "vite": ">=8.1.5 <9",
    "esbuild": "0.28.1",
    "minimatch": ">=9.0.7",
    "@babel/core": ">=8.0.1 <9",
    "@ngrx/signals": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    },
    "ngx-toastr": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    },
    "piscina": "^5.2.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
