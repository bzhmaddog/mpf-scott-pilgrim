# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine

# Static SPA listener on :4200 with client-side routing fallback
COPY ./conf/nginx.conf /etc/nginx/conf.d/default.conf

# Built Angular app
COPY --from=builder /app/dist/front/browser /var/www

