# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly binary — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.webm binary
*.mp4 binary
*.mp3 binary
*.ogg binary
*.wav binary
